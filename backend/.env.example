PORT=8000
HOST=0.0.0.0
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
CHROMA_PATH=d:/HackNex/data/chroma
DATABASE_PATH=d:/HackNex/database/legal_assistant.db
STORAGE_PATH=d:/HackNex/data/documents
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Regex of additional allowed origins. Vercel preview deploys get a unique host each
# push, so this matches all *.vercel.app origins (works with credentials, unlike "*").
CORS_ORIGIN_REGEX=https://[a-zA-Z0-9-]+\.vercel\.app
TOP_K=10
# Supabase — set both to use hosted Postgres (tables via supabase_schema.sql),
# leave empty to use local SQLite (database/legal_assistant.db)
SUPABASE_URL=
SUPABASE_ANON_KEY=
